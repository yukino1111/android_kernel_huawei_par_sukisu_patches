diff --git a/kernel/kpm_map_area.S b/kernel/kpm_map_area.S
new file mode 100644
index 00000000..c42cbc87
--- /dev/null
+++ b/kernel/kpm_map_area.S
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+/*
+ * Dedicated early executable scratch area for KernelPatch.  The generic
+ * non-GKI patcher otherwise borrows tcp_init_sock and must restore it before
+ * networking starts.  Keeping a private area makes staged bring-up safe and
+ * avoids overwriting a live kernel function.
+ */
+
+	.section ".text.kpm_map_area", "ax"
+	.balign 0x800
+	.global kpm_early_map_area
+	.type kpm_early_map_area, %function
+kpm_early_map_area:
+	.space 0x800, 0
+	.size kpm_early_map_area, . - kpm_early_map_area
