diff --git a/mm/pagecache_manage_compat.c b/mm/pagecache_manage_compat.c
new file mode 100644
index 0000000..f03fb09
--- /dev/null
+++ b/mm/pagecache_manage_compat.c
@@ -0,0 +1,15 @@
+/*
+ * Compatibility for Huawei pre-generated storage scheduler assembly.
+ *
+ * The UFS scheduler calls pch_lowmem_check2() unconditionally even when the
+ * page-cache helper is disabled.  MEMCG cannot safely use that helper because
+ * pagecache_manage.S was generated against the stock !MEMCG structure layout.
+ */
+#include <linux/types.h>
+
+#ifndef CONFIG_HISI_PAGECACHE_HELPER
+int pch_lowmem_check2(void)
+{
+	return 0;
+}
+#endif
