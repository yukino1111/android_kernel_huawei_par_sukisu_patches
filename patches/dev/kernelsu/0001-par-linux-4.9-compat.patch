+
+static inline ssize_t par_kernel_write_compat(struct file *file, const void *buf,
+                                              size_t count, loff_t *pos)
+{
+    loff_t offset = pos ? *pos : 0;
+    ssize_t ret = kernel_write(file, buf, count, offset);
+    if (pos && ret > 0)
+        *pos = offset + ret;
+    return ret;
+}
+
+#define kernel_read par_kernel_read_compat
+#define kernel_write par_kernel_write_compat
+
+static inline ssize_t ksu_strscpy_pad(char *dest, const char *src, size_t count)
+{
+    ssize_t ret = strscpy(dest, src, count);
+    if (ret >= 0 && (size_t)ret < count)
+        memset(dest + ret, 0, count - ret);
+    return ret;
+}
+#define strscpy_pad ksu_strscpy_pad
+
+long strncpy_from_user_nofault(char *dst, const void __user *unsafe_addr,
+			       long count);
+
+#endif
