+#define fallthrough do { } while (0)
+#endif
+
+static inline ssize_t par_kernel_read_compat(struct file *file, void *buf,
+                                             size_t count, loff_t *pos)
+{
+    loff_t offset = pos ? *pos : 0;
+    ssize_t ret = kernel_read(file, offset, buf, count);
+    if (pos && ret > 0)
+        *pos = offset + ret;
+    return ret;
