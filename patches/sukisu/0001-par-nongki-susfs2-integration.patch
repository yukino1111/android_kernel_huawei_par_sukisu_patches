--- a/kernel/feature/kernel_umount.c
+++ b/kernel/feature/kernel_umount.c
@@ -48,6 +48,28 @@ static void try_umount(const char *mnt, int flags)
     ksu_umount_mnt(mnt, &path, flags);
 }
 
+#if defined(CONFIG_KSU_SUSFS_TRY_UMOUNT) && !defined(KSU_SUSFS_NATIVE_V2)
+extern bool susfs_is_mnt_devname_ksu(struct path *path);
+
+/* ABI used by the SuSFS v1.5.5 core. */
+void ksu_try_umount(const char *mnt, bool check_mnt, int flags, uid_t uid)
+{
+    struct path path;
+    int err = kern_path(mnt, 0, &path);
+
+    if (err)
+        return;
+    if (path.dentry != path.mnt->mnt_root ||
+        (check_mnt && !susfs_is_mnt_devname_ksu(&path))) {
+        path_put(&path);
+        return;
+    }
+
+    pr_info("susfs: unmounting %s for uid %u\n", mnt, uid);
+    ksu_umount_mnt(mnt, &path, flags);
+}
+#endif
+
